# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# ---------- FRONTEND (Vite). Firebase web config is NOT secret ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
VITE_ADMIN_EMAIL=kahabhns@gmail.com

# ---------- SERVER ONLY (add in Vercel -> Settings -> Environment Variables) ----------
FIREBASE_PROJECT_ID=your-project
ADMIN_EMAIL=kahabhns@gmail.com
# Optional but recommended: locks admin access to one Firebase UID as well.
ADMIN_FIREBASE_UID=

SUPABASE_URL=https://xxxx.supabase.co
# Prefer a modern sb_secret_ key. The legacy service-role key remains supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional independent HMAC secret for anonymous rate-limit identifiers.
# Generate at least 32 random bytes; never expose this as a VITE_ variable.
RATE_LIMIT_SALT=

BROWSERLESS_TOKEN=
BROWSERLESS_URL=https://production-sfo.browserless.io

# Order = priority. Add openrouter only when you have configured that provider.
AI_PROVIDERS=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

DAILY_AUDIT_LIMIT=3
